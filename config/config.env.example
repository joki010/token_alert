# token_alert 설정 파일
# 이 파일을 config.env 로 복사한 뒤 실제 값을 입력하세요.
# cp config/config.env.example config/config.env

# ─────────────────────────────────────────
# 텔레그램 봇 설정
# 발급 방법: docs/telegram-setup.md 참고
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ─────────────────────────────────────────
# GitHub Actions 설정
# 발급 방법: docs/github-setup.md 참고
# ─────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your_github_username
GITHUB_REPO=token_alert
# workflow_dispatch 대상 브랜치 (기본값: main)
# 개선 버전을 별도 브랜치에서 운영하면 해당 브랜치명을 지정하세요.
# GITHUB_REF=main

# ─────────────────────────────────────────
# 감지 설정 (선택)
# ─────────────────────────────────────────
# Claude Code 데이터 경로 (기본값: ~/.claude/projects)
# CLAUDE_PROJECTS_DIR=~/.claude/projects

# GJC(Gajae Code)로 Claude Code를 실행한 경우의 세션 jsonl 경로
# (기본값: ~/.gjc/agent/sessions). JSONL 폴백 시 CLAUDE_PROJECTS_DIR와
# 함께 스캔되어, 어느 쪽 클라이언트로 5시간 한도를 소비했든 감지된다.
# GJC_SESSIONS_DIR=~/.gjc/agent/sessions

# 감지 주기 (초, 기본값: 600 = 10분)
# POLL_INTERVAL=600

# 알림 여유 시간 (초, 기본값: 0 = 정확히 초기화 시각에 알림)
# NOTIFY_ADVANCE_SECONDS=0

# ─────────────────────────────────────────
# 직접 사용량 조회 (선택)
# ─────────────────────────────────────────
# 1로 설정하면 Codex/Claude 사용량 API를 먼저 조회하고, 실패 시 기존 cache/JSONL 추정으로 폴백한다.
# 토큰 값은 로그, 상태 파일, 텔레그램 응답에 저장하지 않는다.
# ENABLE_DIRECT_USAGE=1

# Codex 다중 프로필 경로 (기본값: ~/.codex-switch/profiles)
# 각 하위 디렉터리의 auth.json을 계정별로 조회한다.
# CODEX_PROFILES_DIR=~/.codex-switch/profiles

# Codex auth.json 경로 (기본값: ~/.codex/auth.json)
# CODEX_PROFILES_DIR에서 유효한 프로필을 찾지 못할 때만 fallback으로 쓴다.
# CODEX_AUTH_JSON=~/.codex/auth.json
# 또는 Codex 홈 경로만 지정
# CODEX_HOME=~/.codex

# Claude usage OAuth 자격 파일 경로
# codex-usage-switcher의 Claude usage login이 만든 파일과 같은 형식이다.
# 기본값: ~/.config/claude-usage-bar/credentials.json
# CLAUDE_USAGE_CREDENTIALS=~/.config/claude-usage-bar/credentials.json
